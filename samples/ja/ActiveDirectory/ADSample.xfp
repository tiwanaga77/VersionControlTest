			<fe:Property name="OutputDefault">true</fe:Property>
		</fe:Property>
		<fe:Property name="CloseSession">true</fe:Property>
		<fe:Property name="HttpExecute">false</fe:Property>
		<fb:Description height="308" width="336" x="10" y="226">
			<fb:Property name="Background">40ccffcc</fb:Property>
			<fb:Property name="Text">新入社員を作成</fb:Property>
		</fb:Description>
		<fb:Description height="312" width="578" x="368" y="225">
			<fb:Property name="Background">4099ccff</fb:Property>
			<fb:Property name="Text">新入社員をグループに追加</fb:Property>
		</fb:Description>
		<fb:Description height="119" width="315" x="31" y="74">
			<fb:Property name="Background">40ffff99</fb:Property>
			<fb:Property name="Text">認証</fb:Property>
		</fb:Description>
