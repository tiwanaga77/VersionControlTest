				<fe:Row Name="役職" RealName="title" Value=""/>
				<fe:Row Name="電子メール" RealName="mail" Value=""/>
				<fe:Row Name="携帯電話" RealName="mobile" Value=""/>
			</fe:AdditionalProp>
		</fe:Component>
