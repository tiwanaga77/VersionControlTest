		<fe:Component fb:x="458" fb:y="84" name="RecordGet1" type="CSV(Get)">
			<fb:Description height="17" visible="true" width="166" x="494" y="84">
				<fb:Property name="Text">CSVファイルから社員情報を取得</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="FileNotFoundException"/>
			<fe:Property name="FilePath">data/初期社員.csv</fe:Property>
			<fe:Property name="FilePathDetail" unfold="true">
				<fe:Property name="HomeDirectory">Relative</fe:Property>
				<fe:Property name="AllowAbsolute">true</fe:Property>
				<fe:Property name="AllowUpDir">true</fe:Property>
			</fe:Property>
			<fe:Property name="FileEncoding">utf-8</fe:Property>
			<fe:Property name="StartRow">2</fe:Property>
			<fe:Property name="GetByLoop">1</fe:Property>
			<fe:Output>
				<fe:Stream format="CSV">
					<fe:Property name="StartRow">1</fe:Property>
					<fe:Property name="Separator">,</fe:Property>
					<fe:Property name="QuotedBy">(none)</fe:Property>
					<fe:Property name="QuoteTarget">all</fe:Property>
					<fe:Property name="NullQuoting">quote</fe:Property>
					<fe:Property name="EscapeMode">bs</fe:Property>
					<fe:Property name="ReadTrim">true</fe:Property>
					<fe:Property name="Encoding">utf-8</fe:Property>
					<fe:Property name="LineFeed">(No conversion)</fe:Property>
					<fe:Property name="OutputFieldName">False</fe:Property>
					<fe:FieldDef>
						<fe:Field name="名前" type="String"/>
						<fe:Field name="性" type="String"/>
						<fe:Field name="性フリガナ" type="String"/>
						<fe:Field name="名" type="String"/>
						<fe:Field name="名フリガナ" type="String"/>
						<fe:Field name="ログオン名" type="String"/>
						<fe:Field name="会社名" type="String"/>
						<fe:Field name="会社名フリガナ" type="String"/>
						<fe:Field name="部署" type="String"/>
						<fe:Field name="部署名フリガナ" type="String"/>
						<fe:Field name="役職" type="String"/>
						<fe:Field name="メールアドレス" type="String"/>
						<fe:Field name="携帯電話番号" type="String"/>
						<fe:Field name="所属グループ名" type="String"/>
						<fe:Field name="所属グループ名２" type="String"/>
					</fe:FieldDef>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
