						<mp:Output fb:x="0" fb:y="0" table="CP/CP:ADUserCreate1/Result/部署"/>
						<fb:Line type="Curved"/>
					</mp:Link>
					<mp:Link name="Link11">
						<mp:Input fb:x="0" fb:y="0" table="SD/SD:RecordGet1/SD:F/部署名フリガナ"/>
						<mp:Output fb:x="0" fb:y="0" table="CP/CP:ADUserCreate1/Result/フリガナ（部署）"/>
