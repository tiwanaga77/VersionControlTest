		<fe:Component fb:x="84" fb:y="254" name="ADUserSearch1" type="ADUserSearch">
			<fb:Description height="17" visible="true" width="186" x="120" y="254">
				<fb:Property name="Text">会社にのみ所属する社員を検索します</fb:Property>
			</fb:Description>
			<fe:Property name="BaseDN">cn=Users</fe:Property>
			<fe:Property name="SearchScope">OneLevel</fe:Property>
			<fe:Property name="Timeout">60</fe:Property>
			<fe:Property name="QueryString"/>
			<fe:Property name="SizeLimit">0</fe:Property>
			<fe:Property name="DereferenceLinks">true</fe:Property>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="Exception"/>
			<fe:Property name="RecordNotFoundException"/>
			<fe:AdditionalProp name="Query">
				<fe:Row AndOr="AND" Name="所属するグループ" RealName="memberOf" Relation="=" Value="会社"/>
				<fe:Row AndOr="AND" Name="所属するグループ2" RealName="memberOf" Relation="!=" Value="子会社"/>
			</fe:AdditionalProp>
			<fe:AdditionalProp name="Result">
				<fe:Row Name="フルネーム" RealName="cn"/>
				<fe:Row Name="姓" RealName="sn"/>
				<fe:Row Name="フリガナ（姓）" RealName="msDS-PhoneticLastName"/>
				<fe:Row Name="名" RealName="givenName"/>
				<fe:Row Name="フリカナ（名）" RealName="msDS-PhoneticFirstName"/>
				<fe:Row Name="ユーザーログオン名" RealName="userPrincipalName"/>
				<fe:Row Name="会社名" RealName="company"/>
				<fe:Row Name="フリガナ（会社）" RealName="msDS-PhoneticCompanyName"/>
				<fe:Row Name="部署" RealName="department"/>
				<fe:Row Name="フリガナ（部署）" RealName="msDS-PhoneticDepartment"/>
				<fe:Row Name="役職" RealName="title"/>
				<fe:Row Name="所属するグループ" RealName="memberOf"/>
				<fe:Row Name="携帯電話" RealName="mobile"/>
				<fe:Row Name="電子メール" RealName="mail"/>
			</fe:AdditionalProp>
			<fe:Output>
				<fe:Stream format="Record">
					<fe:FieldDef>
						<fe:Field name="フルネーム" type="String"/>
						<fe:Field name="姓" type="String"/>
						<fe:Field name="フリガナ（姓）" type="String"/>
						<fe:Field name="名" type="String"/>
						<fe:Field name="フリカナ（名）" type="String"/>
						<fe:Field name="ユーザーログオン名" type="String"/>
						<fe:Field name="会社名" type="String"/>
						<fe:Field name="フリガナ（会社）" type="String"/>
						<fe:Field name="部署" type="String"/>
						<fe:Field name="フリガナ（部署）" type="String"/>
						<fe:Field name="役職" type="String"/>
						<fe:Field name="所属するグループ" type="String"/>
						<fe:Field name="携帯電話" type="String"/>
						<fe:Field name="電子メール" type="String"/>
					</fe:FieldDef>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="220" fb:y="356" name="Velocity1" type="HTML (Output)">
			<fe:Property name="Exception"/>
			<fe:Property name="Mode">Inline</fe:Property>
			<fe:Property name="Template">&lt;html&gt;&#xd;
&lt;head&gt;&#xd;
&lt;title&gt;社員リスト&lt;/title&gt;&#xd;
&lt;/head&gt;&#xd;
&lt;body&gt;&#xd;
&lt;h1&gt;会社&lt;/h1&gt;&#xd;
&lt;table border="1"&gt;&#xd;
     &lt;tr&gt;&#xd;
       &lt;th&gt;名前&lt;/th&gt;&#xd;
       &lt;th&gt;部署&lt;/th&gt;&#xd;
       &lt;th&gt;グループ&lt;/th&gt;&#xd;
     &lt;/tr&gt;&#xd;
    #foreach ($r in $in.array(0).records)&#xd;
      &lt;tr&gt;&#xd;
        &lt;td&gt;$r.field("フルネーム")&lt;/td&gt;&#xd;
        &lt;td&gt;$r.field("部署")&lt;/td&gt;&#xd;
        &lt;td&gt;$r.field("所属するグループ")&lt;/td&gt;&#xd;
      &lt;/tr&gt;&#xd;
    #end&#xd;
&lt;/table&gt;&#xd;
&#xd;
&lt;h1&gt;子会社&lt;/h1&gt;&#xd;
&lt;table border="1"&gt;&#xd;
     &lt;tr&gt;&#xd;
       &lt;th&gt;名前&lt;/th&gt;&#xd;
       &lt;th&gt;部署&lt;/th&gt;&#xd;
       &lt;th&gt;グループ&lt;/th&gt;&#xd;
     &lt;/tr&gt;&#xd;
    #foreach ($r in $in.array(1).records)&#xd;
      &lt;tr&gt;&#xd;
        &lt;td&gt;$r.field("フルネーム")&lt;/td&gt;&#xd;
        &lt;td&gt;$r.field("部署")&lt;/td&gt;&#xd;
        &lt;td&gt;$r.field("所属するグループ")&lt;/td&gt;&#xd;
      &lt;/tr&gt;&#xd;
    #end&#xd;
&lt;/table&gt;&#xd;
&#xd;
&lt;/body&gt;&#xd;
&lt;/html&gt;</fe:Property>
			<fe:Property name="TemplateFilename">会社情報.vm</fe:Property>
			<fe:Property name="TemplateHome">Relative</fe:Property>
			<fe:Property name="TemplateEncoding">(AutoDetect)</fe:Property>
			<fe:Property name="XPathVariablePrefix">fv</fe:Property>
