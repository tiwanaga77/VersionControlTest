		<fe:Component fb:x="84" fb:y="84" name="Mapper1" type="Mapper2">
			<fb:Description height="30" visible="true" width="204" x="120" y="84">
				<fb:Property name="Text">ADSample外部変数に設定したログオン名とパスワードをマッピングします
</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="PassStream">false</fe:Property>
			<fe:Property name="CountZeroException">false</fe:Property>
			<fe:Property name="MvMode">2</fe:Property>
			<fe:Property name="Mappings">
				<mp:Mappings>
					<mp:Link name="Link1">
						<mp:Input fb:x="0" fb:y="0" table="EV/ADSample/ログオン名"/>
						<mp:Output fb:x="0" fb:y="0" table="CP/CP:ADAuth1/Principal"/>
						<fb:Line type="Curved"/>
					</mp:Link>
					<mp:Link name="Link2">
						<mp:Input fb:x="0" fb:y="0" table="EV/ADSample/パスワード"/>
						<mp:Output fb:x="0" fb:y="0" table="CP/CP:ADAuth1/Credentials"/>
						<fb:Line type="Curved"/>
					</mp:Link>
				</mp:Mappings>
			</fe:Property>
			<fe:Output>
				<fe:Stream format="Text">
					<fe:Property name="Encoding">utf-8</fe:Property>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="84" fb:y="152" name="ADAuth1" type="ADAuth">
			<fb:Description height="17" visible="true" width="184" x="120" y="152">
				<fb:Property name="Text">ActiveDirectoryで認証をおこないます</fb:Property>
			</fb:Description>
			<fe:Property name="Connection">ADSampleConnection</fe:Property>
			<fe:Property name="Exception"/>
			<fe:Property name="Timeout">60</fe:Property>
			<fe:Property name="Principal"/>
			<fe:Property name="Credentials"/>
		</fe:Component>
		<fe:Component fb:x="84" fb:y="254" name="RecordGet1" type="CSV(Get)">
			<fb:Description height="17" visible="true" width="210" x="120" y="254">
				<fb:Property name="Text">CSVファイルから新入社員情報を取得します</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="FileNotFoundException"/>
			<fe:Property name="FilePath">data/新入社員.csv</fe:Property>
			<fe:Property name="FilePathDetail" unfold="true">
				<fe:Property name="HomeDirectory">Relative</fe:Property>
				<fe:Property name="AllowAbsolute">true</fe:Property>
				<fe:Property name="AllowUpDir">true</fe:Property>
			</fe:Property>
			<fe:Property name="FileEncoding">utf-8</fe:Property>
			<fe:Property name="StartRow">2</fe:Property>
			<fe:Property name="GetByLoop">1</fe:Property>
			<fe:Output>
				<fe:Stream format="CSV">
					<fe:Property name="StartRow">1</fe:Property>
					<fe:Property name="Separator">,</fe:Property>
					<fe:Property name="QuotedBy">(none)</fe:Property>
					<fe:Property name="QuoteTarget">all</fe:Property>
					<fe:Property name="NullQuoting">quote</fe:Property>
					<fe:Property name="EscapeMode">bs</fe:Property>
					<fe:Property name="ReadTrim">true</fe:Property>
					<fe:Property name="Encoding">utf-8</fe:Property>
					<fe:Property name="LineFeed">(No conversion)</fe:Property>
					<fe:Property name="OutputFieldName">False</fe:Property>
					<fe:FieldDef>
						<fe:Field name="名前" type="String"/>
						<fe:Field name="性" type="String"/>
						<fe:Field name="性フリガナ" type="String"/>
						<fe:Field name="名" type="String"/>
						<fe:Field name="名フリガナ" type="String"/>
						<fe:Field name="ログオン名" type="String"/>
						<fe:Field name="会社名" type="String"/>
						<fe:Field name="会社名フリガナ" type="String"/>
						<fe:Field name="部署" type="String"/>
						<fe:Field name="部署名フリガナ" type="String"/>
						<fe:Field name="役職" type="String"/>
						<fe:Field name="メールアドレス" type="String"/>
						<fe:Field name="携帯電話番号" type="String"/>
						<fe:Field name="所属グループ" type="String"/>
						<fe:Field name="所属グループ２" type="String"/>
					</fe:FieldDef>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="84" fb:y="424" name="ADUserCreate1" type="ADUserCreate">
			<fb:Description height="30" visible="true" width="199" x="120" y="424">
