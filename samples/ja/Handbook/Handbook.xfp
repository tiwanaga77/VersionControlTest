		<fe:Component fb:x="322" fb:y="118" name="HandbookCreateSection1" type="HandbookCreateSection">
			<fb:Description height="43" visible="true" width="331" x="376" y="137">
				<fb:Property name="Text">「フォルダーから作成」フローで作成したHandbook「神奈川」に作成したPDFファイル「data/section.pdf」をセクション名「追加のセクション」として追加します</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="ConnectException"/>
			<fe:Property name="APIException"/>
			<fe:Property name="SectionFileException"/>
			<fe:Property name="UseConnection">false</fe:Property>
			<fe:Property name="Connection"/>
			<fe:Property name="ConnectionInfo" unfold="true">
				<fe:Property name="ServerURL"></fe:Property>
				<fe:Property name="LoginUserName"></fe:Property>
				<fe:Property name="LoginPassword"></fe:Property>
				<fe:Property name="UseProxy">false</fe:Property>
			</fe:Property>
			<fe:Property name="Title">神奈川</fe:Property>
			<fe:Property name="Section">追加のセクション</fe:Property>
			<fe:Property name="File">data/section.pdf</fe:Property>
			<fe:Property name="FilePathDetail" unfold="true">
				<fe:Property name="HomeDirectory">Relative</fe:Property>
				<fe:Property name="AllowAbsolute">true</fe:Property>
				<fe:Property name="AllowUpDir">true</fe:Property>
			</fe:Property>
		</fe:Component>
