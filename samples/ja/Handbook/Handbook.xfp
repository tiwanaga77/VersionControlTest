	<fe:Flow id="Flow1" name="フォルダーから作成">
		<fe:Property name="Timeout">180</fe:Property>
		<fe:Property name="Exception"/>
		<fe:Property name="AllowInvoke"/>
		<fe:Property name="LogSettings" unfold="true">
			<fe:Property name="LogName"/>
			<fe:Property name="LogLevel">default</fe:Property>
			<fe:Property name="OutputDefault">true</fe:Property>
		</fe:Property>
		<fe:Property name="CloseSession">true</fe:Property>
		<fe:Property name="HttpExecute">false</fe:Property>
		<fb:Description height="30" width="200" x="86" y="17">
			<fb:Property name="Background">4000ff00</fb:Property>
			<fb:Property name="Text">指定フォルダからHandbookを作成し、Handbookサーバーへアップロードします</fb:Property>
		</fb:Description>
		<fb:Description height="39" width="366" x="86" y="118">
			<fb:Property name="Background">4000ff00</fb:Property>
			<fb:Property name="Text">コネクション情報、URL、ユーザー名、パスワードをそれぞれ設定するか、Handbook用のコネクションを作成して設定してください</fb:Property>
		</fb:Description>
		<fe:Component fb:x="16" fb:y="16" name="Start1" type="Start">
			<fe:Property name="Exception"/>
			<fe:Property name="BeginTransaction">false</fe:Property>
			<fe:Property name="RequiredRole"/>
			<fe:Property name="ArgumentSyncFlowVariables">true</fe:Property>
			<fe:Output>
				<fe:Stream format="Any"/>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="118" name="HandbookCreateFromFolder1" type="HandbookCreateFromFolder">
			<fb:Description height="251" visible="true" width="522" x="86" y="161">
				<fb:Property name="Text">data/神奈川フォルダからHandbookを作成します
神奈川フォルダ内のファイルはそれぞれ以下のように使用されます

-鎌倉フォルダ
　鎌倉というタイトルのチャプターが作成されます
　鎌倉フォルダ下にある「寺.jpg、新緑.jpg、木漏れ日.jpg」の3ファイルはそれぞれファイル名のセクションとなります

-江の島フォルダ
　江の島というタイトルのチャプターが作成されます
　江の島フォルダ下にある「花.jpg、岩場.jpg、江ノ電.jpg」の3ファイルはそれぞれファイル名のセクションとなります

-cover.png
　レイアウトページの表示画像として使用されます

-icon.png
　情報端末の画面で見た場合のHandbookリストのアイコンとして使用されます</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="ConnectException"/>
			<fe:Property name="APIException"/>
			<fe:Property name="FileNotFoundException"/>
			<fe:Property name="UseConnection">false</fe:Property>
			<fe:Property name="Connection"/>
			<fe:Property name="ConnectionInfo" unfold="true">
				<fe:Property name="ServerURL"/>
				<fe:Property name="LoginUserName"/>
				<fe:Property name="LoginPassword"/>
				<fe:Property name="UseProxy">false</fe:Property>
			</fe:Property>
			<fe:Property name="Directory">data/神奈川</fe:Property>
			<fe:Property name="FilePathDetail" unfold="true">
				<fe:Property name="HomeDirectory">Relative</fe:Property>
				<fe:Property name="AllowAbsolute">true</fe:Property>
				<fe:Property name="AllowUpDir">true</fe:Property>
			</fe:Property>
			<fe:Property name="Title"/>
			<fe:Property name="KeyCode">sample</fe:Property>
			<fe:Property name="Category">旅先情報</fe:Property>
			<fe:Property name="Started">2012-01-01T00:00:00</fe:Property>
			<fe:Property name="Erased">2022-12-31T00:00:00</fe:Property>
			<fe:Property name="Description">神奈川県の旅先イメージです</fe:Property>
			<fe:Property name="CopyRight">○○トラベル株式会社</fe:Property>
			<fe:Property name="CopyRightLayout">1</fe:Property>
			<fe:Property name="Downloadable">1</fe:Property>
			<fe:Property name="ExternalAccessable">1</fe:Property>
			<fe:Property name="SectionLayout">1</fe:Property>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="424" name="End1" type="End">
			<fb:Description height="30" visible="true" width="302" x="86" y="425">
				<fb:Property name="Text">作成されたHandbookは、HandbookStudioで確認できます</fb:Property>
			</fb:Description>
			<fe:Property name="CommitTransaction">true</fe:Property>
			<fe:Property name="ReturnValue"/>
		</fe:Component>
		<fe:Link name="Link1">
			<fe:Input name="Start1"/>
			<fe:Output name="HandbookCreateFromFolder1"/>
			<fb:Line type="Direct"/>
		</fe:Link>
		<fe:Link name="Link2">
			<fe:Input name="HandbookCreateFromFolder1"/>
			<fe:Output name="End1"/>
			<fb:Line type="Direct"/>
		</fe:Link>
	</fe:Flow>
