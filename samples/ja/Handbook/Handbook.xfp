			<fb:Description height="30" visible="true" width="248" x="380" y="220">
				<fb:Property name="Text">追加されたセクションは、HandbookStudioよりHandbook「神奈川」で確認できます</fb:Property>
			</fb:Description>
			<fe:Property name="CommitTransaction">true</fe:Property>
			<fe:Property name="ReturnValue"/>
		</fe:Component>
