			<fb:Property name="Text">SharePointサーバーよりファイルをダウンロードします
</fb:Property>
		</fb:Description>
		<fb:Description height="69" width="409" x="86" y="60">
			<fb:Property name="Background">4000ff00</fb:Property>
			<fb:Property name="Text">SharePointサーバーへの接続用コネクションを作成して設定するか、URL、ユーザー名、パスワードなどの接続情報を設定してください
このフローでは、外部変数として、url、username、password、path、filepathを設定し、各外部変数を接続情報や「パス」プロパティに設定していますので、各外部変数に値を設定してからフローを実行してください</fb:Property>
		</fb:Description>
		<fe:Component fb:x="16" fb:y="16" name="Start1" type="Start">
			<fe:Property name="Exception"/>
			<fe:Property name="BeginTransaction">false</fe:Property>
			<fe:Property name="RequiredRole"/>
			<fe:Property name="ArgumentSyncFlowVariables">true</fe:Property>
			<fe:Output>
				<fe:Stream format="Any"/>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="356" name="FilePut1" type="FileSystem(Put)">
			<fb:Description height="17" visible="true" width="139" x="86" y="357">
				<fb:Property name="Text">取得したファイルを保存します</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="AlreadyExistException"/>
			<fe:Property name="FilePath"/>
			<fe:Property name="FilePathDetail" unfold="true">
				<fe:Property name="HomeDirectory">Relative</fe:Property>
				<fe:Property name="AllowAbsolute">true</fe:Property>
				<fe:Property name="AllowUpDir">true</fe:Property>
			</fe:Property>
			<fe:Property name="AppendMode">New</fe:Property>
			<fe:Property name="AllowOverwrite">true</fe:Property>
			<fe:Property name="FileDelete">false</fe:Property>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="254" name="Mapper2" type="Mapper2">
			<fb:Description height="43" visible="true" width="300" x="86" y="253">
				<fb:Property name="Text">フロー変数FILEPATHより、ファイル名を取得しdataフォルダ下のファイルとしてマッピングします</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="PassStream">true</fe:Property>
			<fe:Property name="CountZeroException">false</fe:Property>
			<fe:Property name="MvMode">2</fe:Property>
			<fe:Property name="Mappings">
				<mp:Mappings>
					<mp:Function fb:x="152" fb:y="152" name="Filename1" type="FILENAME">
						<mp:Property name="Get">Name</mp:Property>
					</mp:Function>
					<mp:Function fb:x="152" fb:y="50" name="Const1" type="CONST">
						<fb:Description height="17" visible="true" width="32" x="152" y="86">
							<fb:Property name="Text">data/</fb:Property>
						</fb:Description>
						<mp:Property name="Data">data/</mp:Property>
						<mp:Property name="DataType">String</mp:Property>
						<mp:Property name="EnableMetaCharacter">false</mp:Property>
					</mp:Function>
					<mp:Function fb:x="254" fb:y="50" name="Concatenate1" type="CONCATENATE">
						<mp:Property name="Separator"/>
						<mp:Property name="EnableMetaCharacter">false</mp:Property>
						<mp:Property name="NoSeparatorWhenEmpty">false</mp:Property>
						<mp:Input>
							<mp:Item>Link3</mp:Item>
							<mp:Item>Link2</mp:Item>
						</mp:Input>
					</mp:Function>
					<mp:Link name="Link1">
						<mp:Input fb:x="0" fb:y="0" table="CP/CP:REST/Path"/>
						<mp:Output name="Filename1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link3">
						<mp:Input name="Const1"/>
						<mp:Output name="Concatenate1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link2">
						<mp:Input name="Filename1"/>
						<mp:Output name="Concatenate1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link4">
						<mp:Input name="Concatenate1"/>
						<mp:Output fb:x="0" fb:y="0" table="CP/CP:FilePut1/FilePath"/>
