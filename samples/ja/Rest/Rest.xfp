	<fe:Flow id="Flow1" name="ファイルのアップロード">
		<fe:Property name="Timeout">180</fe:Property>
		<fe:Property name="Exception"/>
		<fe:Property name="AllowInvoke"/>
		<fe:Property name="LogSettings" unfold="true">
			<fe:Property name="LogName"/>
			<fe:Property name="LogLevel">default</fe:Property>
			<fe:Property name="OutputDefault">true</fe:Property>
		</fe:Property>
		<fe:Property name="CloseSession">false</fe:Property>
		<fe:Property name="HttpExecute">false</fe:Property>
		<fb:Description height="69" width="409" x="84" y="58">
			<fb:Property name="Background">4000ff00</fb:Property>
			<fb:Property name="Text">SharePointサーバーへの接続用コネクションを作成して設定するか、URL、ユーザー名、パスワードなどの接続情報を設定してください
このフローでは、外部変数として、url、username、password、path、filepathを設定し、各外部変数を接続情報や「パス」プロパティに設定していますので、各外部変数に値を設定してからフローを実行してください</fb:Property>
		</fb:Description>
		<fb:Description height="30" width="242" x="88" y="18">
			<fb:Property name="Background">4000ff00</fb:Property>
			<fb:Property name="Text">SharePointサーバーへファイルをアップロードします</fb:Property>
		</fb:Description>
		<fe:Component fb:x="16" fb:y="16" name="Start1" type="Start">
			<fe:Property name="Exception"/>
			<fe:Property name="BeginTransaction">false</fe:Property>
			<fe:Property name="RequiredRole"/>
			<fe:Property name="ArgumentSyncFlowVariables">true</fe:Property>
			<fe:Output>
				<fe:Stream format="Any"/>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="458" name="REST" type="REST">
			<fb:Description height="43" visible="true" width="348" x="85" y="459">
				<fb:Property name="Text">PUTメソッドにより、入力ストリームのファイルデータをSharePointサーバーへアップロードします</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="HTTPException"/>
			<fe:Property name="UseConnection">false</fe:Property>
			<fe:Property name="Connection">SharePoint2007</fe:Property>
			<fe:Property name="ConnectionInfo" unfold="true">
				<fe:Property macro="true" name="URL">${exvar.ExVarSharePoint.url}</fe:Property>
				<fe:Property name="URLEncoding">utf-8</fe:Property>
				<fe:Property name="Timeout">60</fe:Property>
				<fe:Property name="BasicAuth" unfold="true">
					<fe:Property macro="true" name="Username">${exvar.ExVarSharePoint.username}</fe:Property>
					<fe:Property macro="true" name="Password">${exvar.ExVarSharePoint.password}</fe:Property>
				</fe:Property>
				<fe:Property name="UseProxy">false</fe:Property>
			</fe:Property>
			<fe:Property macro="true" name="Path">${flow.DIR}</fe:Property>
			<fe:Property name="HTTPMethod">PUT</fe:Property>
			<fe:Property name="AdditionalAhead">Stream</fe:Property>
			<fe:Property name="HTTPVersion">HTTP/1.1</fe:Property>
			<fe:Property name="RetryCount">3</fe:Property>
			<fe:Property name="RetryInterval">1</fe:Property>
			<fe:Property name="FollowRedirects">true</fe:Property>
			<fe:Output>
				<fe:Stream format="Binary"/>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="152" name="Mapper3" type="Mapper2">
			<fb:Description height="30" visible="true" width="195" x="85" y="155">
				<fb:Property name="Text">アップロード先フォルダのパスをフロー変数「DIR」に設定します</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="PassStream">true</fe:Property>
			<fe:Property name="CountZeroException">false</fe:Property>
			<fe:Property name="MvMode">2</fe:Property>
			<fe:Property name="Mappings">
				<mp:Mappings>
					<mp:Function fb:x="152" fb:y="152" name="NullCheck1" type="NullCheck">
						<mp:Property name="AllowEmptyString">false</mp:Property>
						<mp:Input>
							<mp:Item>Link1</mp:Item>
							<mp:Item>Link2</mp:Item>
						</mp:Input>
					</mp:Function>
					<mp:Function fb:x="50" fb:y="254" name="Const1" type="CONST">
						<fb:Description height="17" visible="true" width="99" x="50" y="290">
							<fb:Property name="Text">Docs/Documents/</fb:Property>
						</fb:Description>
						<mp:Property name="Data">Docs/Documents/</mp:Property>
						<mp:Property name="DataType">String</mp:Property>
						<mp:Property name="EnableMetaCharacter">false</mp:Property>
					</mp:Function>
					<mp:Link name="Link1">
						<mp:Input fb:x="0" fb:y="0" table="EV/ExVarSharePoint/path"/>
						<mp:Output name="NullCheck1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link2">
						<mp:Input name="Const1"/>
						<mp:Output name="NullCheck1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link3">
						<mp:Input name="NullCheck1"/>
						<mp:Output fb:x="0" fb:y="0" table="FV/DIR"/>
						<fb:Line type="Direct"/>
					</mp:Link>
				</mp:Mappings>
			</fe:Property>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="254" name="FileGet1" type="FileSystem(Get)">
			<fb:Description height="30" visible="true" width="293" x="85" y="254">
				<fb:Property name="Text">SharePointサーバーへアップロードするファイルを指定します</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="FileNotFoundException"/>
			<fe:Property name="FilePath">data/uploadfile.txt</fe:Property>
			<fe:Property name="FilePathDetail" unfold="true">
				<fe:Property name="HomeDirectory">Relative</fe:Property>
				<fe:Property name="AllowAbsolute">true</fe:Property>
				<fe:Property name="AllowUpDir">true</fe:Property>
			</fe:Property>
			<fe:Property name="FileEncoding">(AutoDetect)</fe:Property>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="FileDelete">false</fe:Property>
			<fe:Output>
				<fe:Stream format="Binary"/>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="458" fb:y="16" name="ExternalVariables1" type="ExternalVariables">
			<fb:Description height="30" visible="true" width="127" x="494" y="16">
				<fb:Property name="Text">ExVarSharePoint
SharePointへの接続情報</fb:Property>
			</fb:Description>
			<fe:Property name="FilePath">ExVarSharePoint.xvar</fe:Property>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="560" name="End1" type="End">
			<fe:Property name="CommitTransaction">true</fe:Property>
			<fe:Property name="ReturnValue"/>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="356" name="Mapper1" type="Mapper2">
			<fb:Description height="43" visible="true" width="348" x="83" y="356">
				<fb:Property name="Text">アップロードするファイルパスからファイル名を取得し、フロー変数「DIR」より合成したパスを「パス」プロパティにマッピングします</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="PassStream">true</fe:Property>
			<fe:Property name="CountZeroException">false</fe:Property>
			<fe:Property name="MvMode">2</fe:Property>
			<fe:Property name="Mappings">
				<mp:Mappings>
					<mp:Function fb:x="84" fb:y="84" name="Filename1" type="FILENAME">
						<mp:Property name="Get">Name</mp:Property>
					</mp:Function>
					<mp:Function fb:x="152" fb:y="152" name="Concatenate1" type="CONCATENATE">
						<mp:Property name="Separator"/>
						<mp:Property name="EnableMetaCharacter">false</mp:Property>
						<mp:Property name="NoSeparatorWhenEmpty">false</mp:Property>
						<mp:Input>
							<mp:Item>Link2</mp:Item>
							<mp:Item>Link5</mp:Item>
							<mp:Item>Link3</mp:Item>
						</mp:Input>
					</mp:Function>
					<mp:Function fb:x="50" fb:y="322" name="Now1" type="NOW">
						<fb:Description height="30" visible="true" width="209" x="50" y="358">
							<fb:Property name="Text">ファイル名に数値を付けて、複数回ファイルアップロードのテストが行えるようにしています</fb:Property>
						</fb:Description>
						<mp:Property name="Format">SSS</mp:Property>
						<mp:Property name="TruncateTime">false</mp:Property>
						<mp:Property name="TimeZone">(default)</mp:Property>
						<mp:Property name="Locale">(default)</mp:Property>
					</mp:Function>
					<mp:Link name="Link1">
						<mp:Input fb:x="0" fb:y="0" table="SD/SD:FileGet1/SD:V/FilePath"/>
						<mp:Output name="Filename1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link2">
						<mp:Input fb:x="0" fb:y="0" table="FV/DIR"/>
						<mp:Output name="Concatenate1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link3">
						<mp:Input name="Filename1"/>
						<mp:Output name="Concatenate1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link4">
						<mp:Input name="Concatenate1"/>
						<mp:Output fb:x="0" fb:y="0" table="CP/CP:REST/Path"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link5">
						<mp:Input name="Now1"/>
						<mp:Output name="Concatenate1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
				</mp:Mappings>
			</fe:Property>
		</fe:Component>
		<fe:Link name="Link1">
			<fe:Input name="Start1"/>
			<fe:Output name="Mapper3"/>
			<fb:Line type="Hooked"/>
		</fe:Link>
		<fe:Link name="Link2">
			<fe:Input name="Mapper3"/>
			<fe:Output name="FileGet1"/>
			<fb:Line type="Hooked"/>
		</fe:Link>
		<fe:Link name="Link4">
			<fe:Input name="REST"/>
			<fe:Output name="End1"/>
			<fb:Line type="Hooked"/>
		</fe:Link>
		<fe:Link name="Link3">
			<fe:Input name="FileGet1"/>
			<fe:Output name="Mapper1"/>
			<fb:Line type="Hooked"/>
		</fe:Link>
		<fe:Link name="Link5">
			<fe:Input name="Mapper1"/>
			<fe:Output name="REST"/>
			<fb:Line type="Hooked"/>
		</fe:Link>
		<fe:Variables>
			<fe:Field access="private" default="Docs/Documents/" name="DIR" type="String"/>
		</fe:Variables>
	</fe:Flow>
	<fe:Flow id="Flow2" name="ファイルのダウンロード">
		<fe:Property name="Timeout">180</fe:Property>
		<fe:Property name="Exception"/>
		<fe:Property name="AllowInvoke"/>
