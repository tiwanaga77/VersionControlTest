	</fe:Flow>
	<fe:Flow id="Flow6" name="WebPage">
		<fe:Property name="Timeout">180</fe:Property>
		<fe:Property name="Exception"/>
		<fe:Property name="AllowInvoke"/>
		<fe:Property name="LogSettings" unfold="true">
			<fe:Property name="LogName"/>
			<fe:Property name="LogLevel">default</fe:Property>
			<fe:Property name="OutputDefault">true</fe:Property>
		</fe:Property>
		<fe:Property name="CloseSession">false</fe:Property>
		<fe:Property name="HttpExecute">false</fe:Property>
		<fb:Description height="56" width="335" x="86" y="17">
			<fb:Property name="Background">4000ff00</fb:Property>
			<fb:Property name="Text">「ファイルリストの取得」フロー、「ファイルのダウンロード」フローを実行するフローです
実行設定を行いブラウザから実行してください
プロトコル例「http://localhost:21380/guest/Rest/WebPage」</fb:Property>
		</fb:Description>
		<fe:Component fb:x="16" fb:y="16" name="HttpStart1" type="HttpStart">
			<fe:Property name="Exception"/>
			<fe:Property name="BeginTransaction">false</fe:Property>
			<fe:Property name="QueryEncoding">(AutoDetect)</fe:Property>
			<fe:Property name="ArgumentSyncFlowVariables">true</fe:Property>
			<fe:Output>
				<fe:Stream format="ParameterList">
					<fe:FieldDef>
						<fe:Field name="path" type="String"/>
						<fe:Field name="filepath" type="String"/>
					</fe:FieldDef>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="254" name="SubFlow1" type="SubFlow2">
			<fb:Description height="17" visible="true" width="94" x="52" y="254">
				<fb:Property name="Text">ファイルリストの取得</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="AssociatedFlow">ファイルリストの取得</fe:Property>
			<fe:Property name="PassStream">false</fe:Property>
			<fe:Output>
				<fe:Stream format="Record">
					<fe:FieldDef>
						<fe:Field name="表示名" type="String"/>
						<fe:Field name="URL" type="String"/>
						<fe:Field name="フォルダ" type="Boolean"/>
					</fe:FieldDef>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="118" name="Mapper1" type="Mapper2">
			<fb:Description height="30" visible="true" width="237" x="85" y="118">
				<fb:Property name="Text">path、filepath、２つのパラメーターを受け取ります</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="PassStream">true</fe:Property>
			<fe:Property name="CountZeroException">false</fe:Property>
			<fe:Property name="MvMode">2</fe:Property>
			<fe:Property name="Mappings">
				<mp:Mappings>
					<mp:Link name="Link4">
						<mp:Input fb:x="0" fb:y="0" table="SD/SD:HttpStart1/SD:F/path"/>
						<mp:Output fb:x="0" fb:y="0" table="EV/ExVarSharePoint/path"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link1">
						<mp:Input fb:x="0" fb:y="0" table="SD/SD:HttpStart1/SD:F/filepath"/>
						<mp:Output fb:x="0" fb:y="0" table="EV/ExVarSharePoint/filepath"/>
						<fb:Line type="Direct"/>
					</mp:Link>
				</mp:Mappings>
			</fe:Property>
		</fe:Component>
		<fe:Component fb:x="458" fb:y="16" name="ExternalVariables1" type="ExternalVariables">
			<fb:Description height="30" visible="true" width="127" x="494" y="16">
				<fb:Property name="Text">ExVarSharePoint
SharePointへの接続情報</fb:Property>
			</fb:Description>
			<fe:Property name="FilePath">ExVarSharePoint.xvar</fe:Property>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="356" name="Velocity1" type="HTML (Output)">
			<fb:Description height="48" visible="true" width="149" x="59" y="355">
				<fb:Property name="Text">Webページ用のHTMLを作成し返します</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="Mode">Inline</fe:Property>
			<fe:Property name="Template">&lt;html&gt;&#xd;
&lt;head&gt;&#xd;
&lt;style type="text/css"&gt;&#xd;
&lt;!--&#xd;
.path{&#xd;
width:600px;&#xd;
}&#xd;
.files{&#xd;
border-collapse: collapse;&#xd;
}&#xd;
table, td, th{&#xd;
border:1px solid #000000;&#xd;
}&#xd;
--&gt;&#xd;
&lt;/style&gt;&#xd;
&lt;script&gt;&#xd;
&lt;!--&#xd;
function changePath(path) {&#xd;
	document.search.filepath.value = "";&#xd;
	document.search.path.value = path.substr("$!{exvar.ExVarSharePoint.url}".length);&#xd;
	document.search.submit();&#xd;
}&#xd;
function download(path) {&#xd;
	document.search.filepath.value = path.substr("$!{exvar.ExVarSharePoint.url}".length);&#xd;
	document.search.submit();&#xd;
}&#xd;
--&gt;&#xd;
&lt;/script&gt;&#xd;
&lt;/head&gt;&#xd;
&lt;body&gt;&#xd;
&lt;h2&gt;SharePointサンプル&lt;h2&gt;&#xd;
&lt;form name="search" method="post" action="WebPage" onsubmit="document.search.filepath.value='';"&gt;&#xd;
検索パス&lt;input class="path" type="text" name="path" value="$!{exvar.ExVarSharePoint.path}"/&gt;&#xd;
&lt;input type="hidden" name="filepath" value=""/&gt;&#xd;
&lt;/form&gt;&#xd;
##レコードinの表示&#xd;
&lt;table class="files"&gt;&#xd;
&lt;tr&gt;&#xd;
&lt;th&gt;ファイル名&lt;/th&gt;&#xd;
&lt;th&gt;パス&lt;/th&gt;&#xd;
&lt;/tr&gt;&#xd;
#foreach ($r in $in.records)&#xd;
&lt;tr&gt;&#xd;
&lt;td&gt;#if ($r.field("フォルダ") == "true")/#end$r.field("表示名")&lt;/td&gt;&#xd;
&lt;td&gt;&#xd;
#if ($r.field("フォルダ") == "true")&#xd;
&lt;a href="javascript:changePath('$r.field("URL")')"&gt;$r.field("URL")&lt;/a&gt;&#xd;
#else&#xd;
&lt;a href="javascript:download('$r.field("URL")')"&gt;$r.field("URL")&lt;/a&gt;&#xd;
#end&#xd;
&lt;/td&gt;&#xd;
&lt;/tr&gt;&#xd;
#end&#xd;
&lt;/table&gt;&#xd;
&lt;/div&gt;&#xd;
&lt;/body&gt;&#xd;
&lt;/html&gt;</fe:Property>
			<fe:Property name="TemplateFilename"/>
			<fe:Property name="TemplateHome">Relative</fe:Property>
			<fe:Property name="TemplateEncoding">(AutoDetect)</fe:Property>
			<fe:Property name="XPathVariablePrefix">fv</fe:Property>
			<fe:Output>
				<fe:Stream format="HTML">
					<fe:Property name="Encoding">utf-8</fe:Property>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="458" name="HttpEnd1" type="HttpEnd">
			<fe:Property name="CommitTransaction">true</fe:Property>
			<fe:Property name="ReturnValue"/>
			<fe:Property name="ContentType">(AutoDetect)</fe:Property>
			<fe:Property name="Location"/>
			<fe:Property name="Download" unfold="true">
				<fe:Property name="FileName"/>
			</fe:Property>
			<fe:Property name="JSONPCallback"/>
		</fe:Component>
		<fe:Component fb:x="118" fb:y="186" name="BranchStart1" type="BranchFilterStart">
			<fb:Description height="56" visible="true" width="331" x="295" y="169">
				<fb:Property name="Text">filepathパラメーターが設定されているときは「ファイルのダウンロード」フローを実行し、設定されていないときは「ファイルリストの取得」フローを実行するように処理を分岐します
</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="Condition">$exvar.ExVarSharePoint.filepath!=""</fe:Property>
			<fe:Property name="EvaluateMode">Any one</fe:Property>
		</fe:Component>
		<fe:Component fb:x="254" fb:y="254" name="SubFlow2" type="SubFlow2">
			<fb:Description height="17" visible="true" width="101" x="290" y="254">
				<fb:Property name="Text">ファイルのダウンロード</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="AssociatedFlow">ファイルのダウンロード</fe:Property>
			<fe:Property name="PassStream">false</fe:Property>
			<fe:Output>
				<fe:Stream format="Binary"/>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="254" fb:y="458" name="HttpEnd2" type="HttpEnd">
			<fe:Property name="CommitTransaction">true</fe:Property>
			<fe:Property name="ReturnValue"/>
			<fe:Property name="ContentType">(AutoDetect)</fe:Property>
			<fe:Property name="Location"/>
			<fe:Property name="Download" unfold="true">
				<fe:Property name="FileName"/>
			</fe:Property>
			<fe:Property name="JSONPCallback"/>
		</fe:Component>
		<fe:Component fb:x="254" fb:y="356" name="Mapper2" type="Mapper2">
			<fb:Description height="17" visible="true" width="200" x="290" y="356">
				<fb:Property name="Text">ダウンロードしたファイル名をマッピングします</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="PassStream">true</fe:Property>
			<fe:Property name="CountZeroException">false</fe:Property>
			<fe:Property name="MvMode">2</fe:Property>
			<fe:Property name="Mappings">
				<mp:Mappings>
					<mp:Function fb:x="118" fb:y="152" name="Filename1" type="FILENAME">
						<mp:Property name="Get">Name</mp:Property>
					</mp:Function>
					<mp:Link name="Link1">
						<mp:Input fb:x="0" fb:y="0" table="EV/ExVarSharePoint/filepath"/>
						<mp:Output name="Filename1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link2">
						<mp:Input name="Filename1"/>
						<mp:Output fb:x="0" fb:y="0" table="CP/CP:HttpEnd2/FileName"/>
						<fb:Line type="Direct"/>
					</mp:Link>
				</mp:Mappings>
			</fe:Property>
		</fe:Component>
		<fe:Link name="Link1">
			<fe:Input name="HttpStart1"/>
			<fe:Output name="Mapper1"/>
			<fb:Line type="Hooked"/>
		</fe:Link>
