				<fe:Stream format="Any"/>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="220" name="REST1" type="REST">
			<fb:Description height="43" visible="true" width="387" x="87" y="218">
				<fb:Property name="Text">PROPFINDメソッドを実行し、SharePointサーバーからファイルリストを取得します
検索パスはフロー変数の初期値に「/Docs/Documents/」が指定されています</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="HTTPException"/>
			<fe:Property name="UseConnection">false</fe:Property>
			<fe:Property name="Connection">SharePoint2007</fe:Property>
			<fe:Property name="ConnectionInfo" unfold="true">
				<fe:Property macro="true" name="URL">${exvar.ExVarSharePoint.url}</fe:Property>
				<fe:Property name="URLEncoding">utf-8</fe:Property>
				<fe:Property name="Timeout">60</fe:Property>
				<fe:Property name="BasicAuth" unfold="true">
					<fe:Property macro="true" name="Username">${exvar.ExVarSharePoint.username}</fe:Property>
					<fe:Property macro="true" name="Password">${exvar.ExVarSharePoint.password}</fe:Property>
				</fe:Property>
				<fe:Property name="UseProxy">false</fe:Property>
			</fe:Property>
			<fe:Property macro="true" name="Path">${exvar.ExVarSharePoint.path}</fe:Property>
			<fe:Property name="HTTPMethod">PROPFIND</fe:Property>
			<fe:Property name="AdditionalAhead">Stream</fe:Property>
			<fe:Property name="HTTPVersion">HTTP/1.1</fe:Property>
			<fe:Property name="RetryCount">3</fe:Property>
			<fe:Property name="RetryInterval">1</fe:Property>
			<fe:Property name="FollowRedirects">true</fe:Property>
			<fe:Output>
				<fe:Stream format="XML">
					<fe:Property name="DTDFilePath"/>
					<fe:Property name="Normalize">false</fe:Property>
					<fe:Property name="Validate">false</fe:Property>
					<fe:Property name="Encoding">utf-8</fe:Property>
					<fe:Property name="LineFeed">(No conversion)</fe:Property>
					<fe:Property name="OutputForm">(none)</fe:Property>
					<fe:Property name="OutputXMLDeclaration">true</fe:Property>
					<fe:Property name="EmptyTag">true</fe:Property>
					<fe:FieldDef>
						<fe:Namespace prefix="D" uri="DAV:"/>
						<fe:Namespace prefix="Z" uri="urn:schemas-microsoft-com:"/>
						<fe:Namespace prefix="Office" uri="urn:schemas-microsoft-com:office:office"/>
						<fe:Namespace prefix="Repl" uri="http://schemas.microsoft.com/repl/"/>
						<fe:Field expanded="true" name="D:multistatus" nodeType="Element" repeat="false" type="String">
							<fe:Field expanded="true" name="D:response" nodeType="Element" repeat="true" type="String">
								<fe:Field name="D:href" nodeType="Element" repeat="false" type="String"/>
								<fe:Field expanded="true" name="D:propstat" nodeType="Element" repeat="false" type="String">
									<fe:Field expanded="true" name="D:prop" nodeType="Element" repeat="false" type="String">
										<fe:Field name="D:displayname" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="D:lockdiscovery" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="D:supportedlock" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="D:isFolder" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="D:iscollection" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="D:ishidden" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="D:getcontenttype" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="D:getcontentlength" nodeType="Element" repeat="false" type="String"/>
										<fe:Field expanded="true" name="D:resourcetype" nodeType="Element" repeat="false" type="String">
											<fe:Field name="D:collection" nodeType="Element" repeat="false" type="String"/>
										</fe:Field>
										<fe:Field name="Repl:authoritative-directory" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="D:getlastmodified" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="D:creationdate" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="Repl:repl-uid" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="Repl:resourcetag" nodeType="Element" repeat="false" type="String"/>
										<fe:Field name="D:getetag" nodeType="Element" repeat="false" type="String"/>
									</fe:Field>
									<fe:Field name="D:status" nodeType="Element" repeat="false" type="String"/>
								</fe:Field>
							</fe:Field>
						</fe:Field>
					</fe:FieldDef>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="356" name="Mapper1" type="Mapper2">
			<fb:Description height="43" visible="true" width="287" x="81" y="354">
				<fb:Property name="Text">取得したレスポンスXMLよりデータを取得し、表示名、URL、フォルダかどうかの、3フィールドを持つレコードストリームを作成します</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="PassStream">false</fe:Property>
			<fe:Property name="CountZeroException">false</fe:Property>
			<fe:Property name="MvMode">2</fe:Property>
			<fe:Property name="Mappings">
				<mp:Mappings>
					<mp:Function fb:x="186" fb:y="118" name="Equal1" type="Equal">
						<mp:Property name="Operator">==</mp:Property>
						<mp:Property name="Data">t</mp:Property>
						<mp:Property name="CompareType">String</mp:Property>
						<mp:Input>
							<mp:Item>Link4</mp:Item>
						</mp:Input>
					</mp:Function>
					<mp:Link name="Link1">
						<mp:Input fb:x="0" fb:y="0" table="SD/SD:REST1/SD:F/D:multistatus/D:response/D:href"/>
						<mp:Output fb:x="0" fb:y="0" table="SD/SD:F/URL"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link2">
						<mp:Input fb:x="0" fb:y="0" table="SD/SD:REST1/SD:F/D:multistatus/D:response/D:propstat/D:prop/D:displayname"/>
						<mp:Output fb:x="0" fb:y="0" table="SD/SD:F/表示名"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link4">
						<mp:Input fb:x="0" fb:y="0" table="SD/SD:REST1/SD:F/D:multistatus/D:response/D:propstat/D:prop/D:isFolder"/>
						<mp:Output name="Equal1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link3">
						<mp:Input name="Equal1"/>
						<mp:Output fb:x="0" fb:y="0" table="SD/SD:F/フォルダ"/>
						<fb:Line type="Direct"/>
					</mp:Link>
				</mp:Mappings>
			</fe:Property>
			<fe:Output>
				<fe:Stream format="Record">
					<fe:FieldDef>
						<fe:Field name="表示名" type="String"/>
						<fe:Field name="URL" type="String"/>
						<fe:Field name="フォルダ" type="Boolean"/>
					</fe:FieldDef>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="458" name="EndResponse1" type="EndResponse">
