		</fe:Component>
		<fe:Component fb:x="16" fb:y="152" name="REST" type="REST">
			<fb:Description height="17" visible="true" width="178" x="86" y="155">
				<fb:Property name="Text">GETメソッドによりファイルを取得します</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="HTTPException"/>
			<fe:Property name="UseConnection">false</fe:Property>
			<fe:Property name="Connection">SharePoint2007</fe:Property>
			<fe:Property name="ConnectionInfo" unfold="true">
				<fe:Property macro="true" name="URL">${exvar.ExVarSharePoint.url}</fe:Property>
				<fe:Property name="URLEncoding">utf-8</fe:Property>
				<fe:Property name="Timeout">60</fe:Property>
				<fe:Property name="BasicAuth" unfold="true">
					<fe:Property macro="true" name="Username">${exvar.ExVarSharePoint.username}</fe:Property>
					<fe:Property macro="true" name="Password">${exvar.ExVarSharePoint.password}</fe:Property>
				</fe:Property>
				<fe:Property name="UseProxy">false</fe:Property>
			</fe:Property>
			<fe:Property macro="true" name="Path">${exvar.ExVarSharePoint.filepath}</fe:Property>
			<fe:Property name="HTTPMethod">GET</fe:Property>
			<fe:Property name="AdditionalAhead">Stream</fe:Property>
			<fe:Property name="HTTPVersion">HTTP/1.1</fe:Property>
			<fe:Property name="RetryCount">3</fe:Property>
			<fe:Property name="RetryInterval">1</fe:Property>
			<fe:Property name="FollowRedirects">true</fe:Property>
			<fe:Output>
				<fe:Stream format="Binary"/>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="458" fb:y="16" name="ExternalVariables1" type="ExternalVariables">
			<fb:Description height="30" visible="true" width="127" x="494" y="16">
				<fb:Property name="Text">ExVarSharePoint
SharePointへの接続情報</fb:Property>
			</fb:Description>
			<fe:Property name="FilePath">ExVarSharePoint.xvar</fe:Property>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="458" name="EndResponse1" type="EndResponse">
