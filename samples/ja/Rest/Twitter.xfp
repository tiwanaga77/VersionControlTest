	<fe:Flow id="Flow1" name="QueryTweets">
		<fe:Property name="Timeout">180</fe:Property>
		<fe:Property name="Exception"/>
		<fe:Property name="AllowInvoke"/>
		<fe:Property name="LogSettings" unfold="true">
			<fe:Property name="LogName"/>
			<fe:Property name="LogLevel">default</fe:Property>
			<fe:Property name="OutputDefault">true</fe:Property>
		</fe:Property>
		<fe:Property name="CloseSession">true</fe:Property>
		<fe:Property name="HttpExecute">false</fe:Property>
		<fb:Description height="64" width="343" x="84" y="17">
			<fb:Property name="Background">4000ff00</fb:Property>
			<fb:Property name="Text">Twitterから指定の検索条件を含むTweetを検索します

※ShowTweetsフローのサブフローとして実行します</fb:Property>
		</fb:Description>
		<fe:Component fb:x="16" fb:y="16" name="Start1" type="Start">
			<fe:Property name="Exception"/>
			<fe:Property name="BeginTransaction">false</fe:Property>
			<fe:Property name="RequiredRole"/>
			<fe:Property name="ArgumentSyncFlowVariables">true</fe:Property>
			<fe:Output>
				<fe:Stream format="Any"/>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="118" name="Mapper1" type="Mapper2">
			<fb:Description height="30" visible="true" width="258" x="85" y="119">
				<fb:Property name="Text">検索条件、ページ、表示件数をマッピングします</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="PassStream">false</fe:Property>
			<fe:Property name="CountZeroException">false</fe:Property>
			<fe:Property name="MvMode">2</fe:Property>
			<fe:Property name="Mappings">
				<mp:Mappings>
					<mp:Link name="Link1">
						<mp:Input fb:x="0" fb:y="0" table="FV/query"/>
						<mp:Output fb:x="0" fb:y="0" table="CP/CP:REST1/URLParameters/q"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link2">
						<mp:Input fb:x="0" fb:y="0" table="FV/rpp"/>
						<mp:Output fb:x="0" fb:y="0" table="CP/CP:REST1/URLParameters/rpp"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link3">
						<mp:Input fb:x="0" fb:y="0" table="FV/page"/>
						<mp:Output fb:x="0" fb:y="0" table="CP/CP:REST1/URLParameters/page"/>
						<fb:Line type="Direct"/>
					</mp:Link>
				</mp:Mappings>
			</fe:Property>
			<fe:Output>
				<fe:Stream format="Text">
					<fe:Property name="Encoding">utf-8</fe:Property>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="220" name="REST1" type="REST">
			<fb:Description height="30" visible="true" width="316" x="85" y="222">
				<fb:Property name="Text">Twitterの検索用サーバーに対してパラメーターを送信します</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="HTTPException"/>
			<fe:Property name="UseConnection">false</fe:Property>
			<fe:Property name="Connection"/>
			<fe:Property name="ConnectionInfo" unfold="true">
				<fe:Property name="URL">http://search.twitter.com/search.atom</fe:Property>
				<fe:Property name="URLEncoding">utf-8</fe:Property>
				<fe:Property name="Timeout">60</fe:Property>
				<fe:Property name="BasicAuth" unfold="true">
					<fe:Property name="Username"/>
					<fe:Property name="Password"/>
				</fe:Property>
				<fe:Property name="UseProxy">false</fe:Property>
			</fe:Property>
			<fe:Property name="Path"/>
			<fe:Property name="HTTPMethod">GET</fe:Property>
			<fe:Property name="AdditionalAhead">Stream</fe:Property>
			<fe:Property name="HTTPVersion">HTTP/1.1</fe:Property>
			<fe:Property name="RetryCount">3</fe:Property>
			<fe:Property name="RetryInterval">1</fe:Property>
			<fe:Property name="FollowRedirects">true</fe:Property>
			<fe:AdditionalProp name="URLParameters">
				<fe:Row Default="ASTERIA WARP" Name="q" Type="String"/>
				<fe:Row Default="ja" Name="lang" Type="String"/>
				<fe:Row Default="ja" Name="locale" Type="String"/>
				<fe:Row Name="page" Type="String"/>
				<fe:Row Default="100" Name="rpp" Type="String"/>
			</fe:AdditionalProp>
			<fe:Output>
				<fe:Stream format="XML">
					<fe:Property name="DTDFilePath"/>
					<fe:Property name="Normalize">false</fe:Property>
					<fe:Property name="Validate">false</fe:Property>
					<fe:Property name="Encoding">utf-8</fe:Property>
					<fe:Property name="LineFeed">(No conversion)</fe:Property>
					<fe:Property name="OutputForm">NWS&amp;Indent</fe:Property>
					<fe:Property name="OutputXMLDeclaration">true</fe:Property>
					<fe:Property name="EmptyTag">true</fe:Property>
					<fe:FieldDef>
						<fe:Namespace prefix="a" uri="http://www.w3.org/2005/Atom"/>
						<fe:Namespace prefix="google" uri="http://base.google.com/ns/1.0"/>
						<fe:Namespace prefix="twitter" uri="http://api.twitter.com/"/>
						<fe:Namespace prefix="openSearch" uri="http://a9.com/-/spec/opensearch/1.1/"/>
						<fe:Namespace prefix="georss" uri="http://www.georss.org/georss"/>
						<fe:Field expanded="true" name="a:feed" nodeType="Element" repeat="false" type="String">
							<fe:Field name="xml:lang" nodeType="Attribute" repeat="false" type="String"/>
							<fe:Field name="a:id" nodeType="Element" repeat="false" type="String"/>
							<fe:Field expanded="true" name="a:link" nodeType="Element" repeat="true" type="String">
								<fe:Field name="href" nodeType="Attribute" repeat="false" type="String"/>
								<fe:Field name="rel" nodeType="Attribute" repeat="false" type="String"/>
								<fe:Field name="type" nodeType="Attribute" repeat="false" type="String"/>
							</fe:Field>
							<fe:Field name="a:title" nodeType="Element" repeat="false" type="String"/>
							<fe:Field name="a:updated" nodeType="Element" repeat="false" type="String"/>
							<fe:Field name="openSearch:itemsPerPage" nodeType="Element" repeat="false" type="String"/>
							<fe:Field name="openSearch:language" nodeType="Element" repeat="false" type="String"/>
