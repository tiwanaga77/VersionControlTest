		</fe:Component>
		<fe:Component fb:x="16" fb:y="220" name="SubFlow1" type="SubFlow2">
			<fb:Description height="30" visible="true" width="314" x="88" y="223">
				<fb:Property name="Text">QueryTweetsフローを実行し、検索条件にヒットしたTweet情報をレコードストリームとして受けとります</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="AssociatedFlow">QueryTweets</fe:Property>
			<fe:Property name="PassStream">false</fe:Property>
			<fe:AdditionalProp name="Param">
				<fe:Row Name="query" Type="String"/>
