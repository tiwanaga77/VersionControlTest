<?xml version="1.0" encoding="utf-8"?>
<fe:Project fb:created="2011-12-07T11:14:11.733 JST" fb:idSeq="4" fb:version="1.0" id="2dc7a495-9dc9-4f97-8511-921db823e8da" name="Twitter" version="1.0" xmlns:fb="http://www.infoteria.com/asteria/flowbuilder" xmlns:fe="http://www.infoteria.com/asteria/flowengine" xmlns:mp="http://www.infoteria.com/asteria/mapper">
	<fb:Property name="CreatedVersion">4.6.0.6778</fb:Property>
	<fb:Property name="UpdateVersion">4.6.0.6840</fb:Property>
	<fb:Property name="Revision"/>
	<fb:Property name="Author"/>
	<fb:Property name="Copyright"/>
	<fe:Property name="CacheType">true</fe:Property>
	<fe:Property name="AllowInvoke"/>
	<fe:Property name="LogSettings" unfold="true">
		<fe:Property name="LogName"/>
		<fe:Property name="LogLevel">default</fe:Property>
		<fe:Property name="OutputDefault">true</fe:Property>
	</fe:Property>
	<fe:Flow id="Flow2" name="ShowTweets">
		<fe:Property name="Timeout">180</fe:Property>
		<fe:Property name="Exception"/>
		<fe:Property name="AllowInvoke"/>
		<fe:Property name="LogSettings" unfold="true">
			<fe:Property name="LogName"/>
			<fe:Property name="LogLevel">default</fe:Property>
			<fe:Property name="OutputDefault">true</fe:Property>
		</fe:Property>
		<fe:Property name="CloseSession">false</fe:Property>
		<fe:Property name="HttpExecute">true</fe:Property>
		<fb:Description height="17" visible="false" width="177" x="0" y="0">
			<fb:Property name="Text">ヘッダとレコードをExcelファイルに設定</fb:Property>
		</fb:Description>
		<fb:Description height="69" width="416" x="86" y="17">
			<fb:Property name="Background">4000ff00</fb:Property>
			<fb:Property name="Text">Twitterより検索条件にあうTweetを指定件数だけ取得してHTMLページを返します 

※このフローを「実行設定」でURLトリガーに登録して、ブラウザより実行してください</fb:Property>
		</fb:Description>
		<fe:Component fb:x="16" fb:y="16" name="HttpStart1" type="HttpStart">
			<fe:Property name="Exception"/>
			<fe:Property name="BeginTransaction">false</fe:Property>
			<fe:Property name="QueryEncoding">utf-8</fe:Property>
			<fe:Property name="ArgumentSyncFlowVariables">true</fe:Property>
			<fe:AdditionalProp name="Cookie">
				<fe:Row Name="Columns" Type="String"/>
			</fe:AdditionalProp>
			<fe:Output>
				<fe:Stream format="ParameterList">
					<fe:FieldDef>
						<fe:Field name="Page" type="String"/>
						<fe:Field name="RPP" type="String"/>
						<fe:Field name="query" type="String"/>
					</fe:FieldDef>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="322" name="Velocity1" type="HTML (Output)">
			<fb:Description height="32" visible="true" width="273" x="88" y="325">
				<fb:Property name="Text">レコードストリームよりHTMLページを作成します</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="Mode">Inline</fe:Property>
			<fe:Property name="Template">##値を表示するためのマクロ
##数値はカンマ区切りにする
##日付は「yyyy/MM/dd HH:mm:ss」形式にする
##文字列はmaxLenよりも長い場合は切り詰める
#set ($format = '#,##0')
#macro (printValue $value $maxLen)
#set ($type = $value.Type.toString())
#if ($type == "Integer")
$sys.formatDecimal($value, $format)
#elseif ($type == "Decimal")
$sys.formatDecimal($value, $format)
#elseif ($type == "DateTime")
#set ($temp = $sys.formatDate($value, "yyyy/MM/dd HH:mm:ss"))
#if ($temp.endsWith("00:00:00"))
#set ($tempLen = $temp.length() - 8)
#set ($temp = $temp.substring(0, $tempLen))
#end
$temp
#elseif ($maxLen != 0 &amp;&amp; $value.strValue().length() &gt; $maxLen)
${value.strValue().substring(0, $maxLen)}...
#elseif ($value.strValue().length() == 0)
&amp;nbsp;
#else
$value
#end
#end
&lt;html&gt;
&lt;head&gt;
&lt;style type="text/css"&gt;
&lt;!--
h1{
	color : white;
	padding : 4px 0 4px 8px; 
	background-color : #333333;
	font-size : 150% ;
}
th{
	background-color : #888888 ;
	color : #000022;
}
.container {
	padding: 10px 10px 20px 10px ;
}

.user {
	font-weight: bold;
	background-color : #cccccc ;
	color : #000022;
	padding: 3px 3px 3px 3px ;
}
.contents {
	color : #333333;
	padding: 3px 3px 3px 5px ;
}
--&gt;
&lt;/style&gt;
&lt;script&gt;
&lt;!--
function doSubmit(spos) {
	form = document.searchForm;
	form.Page.value = spos;
	form.submit();
}

--&gt;
&lt;/script&gt;

#set ($title = "Search Tweets")
&lt;title&gt;$title&lt;/title&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;h1&gt;$title&lt;/h1&gt;
##ナビゲーター
#set ($navi = "　　")
#if ($flow.Page.intValue() != 1)
    #set ($prev = $flow.Page.intValue() - 1)
    #if ($prev &lt;= 0) 
      #set ($prev = 1) 
    #end
    #set ($navi = "$navi&lt;a href='javascript:doSubmit(1)'&gt;先頭&lt;/a&gt;　")
    #set ($navi = "$navi&lt;a href='javascript:doSubmit($prev)'&gt;前へ&lt;/a&gt;　　　　")
#else
    #set ($navi = "$navi先頭　前へ　　　　")
#end
#set ($next = $flow.Page.intValue() + 1)
#set ($navi = "$navi&lt;a href='javascript:doSubmit($next)'&gt;次へ&lt;/a&gt;　")
#set ($navi = "&lt;div&gt;$navi&lt;/div&gt;")
##検索フォーム
#set ($pathPos = $system.RequestURL.strValue().lastIndexOf('/') + 1)
&lt;form name="searchForm" action="$system.RequestURL.strValue().substring($pathPos)" method="post"&gt;
&lt;input type="hidden" name="Page" value="$flow.Page"&gt;
&lt;table border="0" style="font-size:smaller;width:80%;"&gt;
&lt;tr&gt;
	&lt;th&gt;検索文字列&lt;/th&gt;&lt;td&gt;&lt;input name="query" value="$!flow.get("query")" size="60"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
	&lt;td colspan="2"&gt;
		表示行数　
		&lt;select name="RPP"&gt;
			&lt;option value="50"   #if($flow.RPP.intValue() == 50)  selected #end&gt;50&lt;/option&gt;
			&lt;option value="100"  #if($flow.RPP.intValue() == 100) selected #end&gt;100&lt;/option&gt;
			&lt;option value="1000" #if($flow.RPP.intValue() == 1000)selected #end&gt;1000&lt;/option&gt;
		&lt;/select&gt;　　
		&lt;input type="button" onclick="doSubmit($flow.Page)" value="再表示"&gt;　　
	&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;
&lt;/form&gt;
$navi
##レコードの表示
&lt;div&gt;
#foreach ($r in $in.records)
	&lt;div class="container"&gt;&lt;div class="user"&gt;$r.field("user")&lt;/div&gt;&lt;div class="contents"&gt;$r.field("contents")&lt;/div&gt;&lt;/div&gt;
#end
&lt;/div&gt;
$navi
&lt;/body&gt;
&lt;/html&gt;

</fe:Property>
			<fe:Property name="TemplateFilename">ShowImages/OutputHTML.vm</fe:Property>
			<fe:Property name="TemplateHome">Relative</fe:Property>
			<fe:Property name="TemplateEncoding">utf-8</fe:Property>
			<fe:Property name="XPathVariablePrefix">fv</fe:Property>
			<fe:Output>
