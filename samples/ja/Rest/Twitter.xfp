				<fe:Row Default="1" Name="page" Type="Integer"/>
			</fe:AdditionalProp>
			<fe:Output>
				<fe:Stream format="Record">
					<fe:FieldDef>
						<fe:Field name="id" type="String"/>
						<fe:Field name="user" type="String"/>
						<fe:Field name="contents" type="String"/>
					</fe:FieldDef>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="118" name="Mapper1" type="Mapper2">
			<fb:Description height="30" visible="true" width="353" x="88" y="121">
				<fb:Property name="Text">urlパラメーターとして受け取った値、もしくはデフォルト値をマッピングします</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
