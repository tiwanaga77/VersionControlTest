<?xml version="1.0" encoding="utf-8"?>
<fe:Project fb:created="2012-01-29T14:25:06.545 JST" fb:idSeq="2" fb:version="1.0" id="3ebd7f96-835d-45ea-9d80-8fdddff8f52f" name="Mapper" version="1.0" xmlns:fb="http://www.infoteria.com/asteria/flowbuilder" xmlns:fe="http://www.infoteria.com/asteria/flowengine" xmlns:mp="http://www.infoteria.com/asteria/mapper">
	<fb:Property name="CreatedVersion">4.6.0.6838</fb:Property>
	<fb:Property name="UpdateVersion">4.6.0.6838</fb:Property>
	<fb:Property name="Revision"/>
	<fb:Property name="Author"/>
	<fb:Property name="Copyright"/>
	<fe:Property name="CacheType">true</fe:Property>
	<fe:Property name="AllowInvoke"/>
	<fe:Property name="LogSettings" unfold="true">
		<fe:Property name="LogName"/>
		<fe:Property name="LogLevel">default</fe:Property>
		<fe:Property name="OutputDefault">true</fe:Property>
	</fe:Property>
	<fe:Flow id="Flow1" name="郵便番号検索">
		<fe:Property name="Timeout">180</fe:Property>
		<fe:Property name="Exception"/>
		<fe:Property name="AllowInvoke"/>
		<fe:Property name="LogSettings" unfold="true">
			<fe:Property name="LogName"/>
			<fe:Property name="LogLevel">default</fe:Property>
			<fe:Property name="OutputDefault">true</fe:Property>
		</fe:Property>
		<fe:Property name="CloseSession">true</fe:Property>
		<fe:Property name="HttpExecute">false</fe:Property>
		<fb:Description height="59" width="442" x="85" y="18">
			<fb:Property name="Background">4000ff00</fb:Property>
			<fb:Property name="Text">郵便番号から住所を検索します
検索できる郵便番号は東京の郵便番号です

フローの実行時に公開フロー変数である郵便番号に検索したい郵便番号を入力してください</fb:Property>
		</fb:Description>
		<fe:Component fb:x="16" fb:y="16" name="Start1" type="Start">
			<fe:Property name="Exception"/>
			<fe:Property name="BeginTransaction">false</fe:Property>
			<fe:Property name="RequiredRole"/>
			<fe:Property name="ArgumentSyncFlowVariables">true</fe:Property>
			<fe:Output>
				<fe:Stream format="Any"/>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="118" name="Mapper1" type="Mapper2">
			<fb:Description height="33" visible="true" width="368" x="86" y="118">
				<fb:Property name="Text">Mapperの中で入力された郵便番号から住所を検索します
ここでは、ダウンロードした東京の郵便番号データから住所を検索しています</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="PassStream">false</fe:Property>
			<fe:Property name="CountZeroException">false</fe:Property>
			<fe:Property name="MvMode">2</fe:Property>
			<fe:Property name="Mappings">
				<mp:Mappings>
					<mp:Function fb:x="50" fb:y="84" name="Split1" type="Split">
						<fb:Description height="43" visible="true" width="200" x="50" y="154">
							<fb:Property name="Text">郵便番号をハイフンで分割します
ハイフンがなかった場合は２番目の
出力は空文字になります</fb:Property>
						</fb:Description>
						<fb:Property name="Icon">str_split2.png</fb:Property>
						<mp:Property name="Separator">-</mp:Property>
						<mp:Property name="Count">2</mp:Property>
						<mp:Property name="SearchDir">Left</mp:Property>
						<mp:Property name="SeparatorMode">None</mp:Property>
						<mp:Input>
							<mp:Item>Link1</mp:Item>
						</mp:Input>
					</mp:Function>
					<mp:Function fb:x="118" fb:y="50" name="Concatenate1" type="CONCATENATE">
						<fb:Description height="56" visible="true" width="208" x="118" y="86">
							<fb:Property name="Text">2つの入力を連結
してハイフンがない
郵便番号を作ります</fb:Property>
						</fb:Description>
						<mp:Property name="Separator"/>
						<mp:Property name="EnableMetaCharacter">false</mp:Property>
						<mp:Property name="NoSeparatorWhenEmpty">false</mp:Property>
						<mp:Input>
							<mp:Item>Link2</mp:Item>
							<mp:Item>Link3</mp:Item>
						</mp:Input>
					</mp:Function>
					<mp:Function fb:x="254" fb:y="50" name="Table1" type="TABLE">
						<fb:Description height="108" visible="true" width="231" x="254" y="154">
							<fb:Property name="Text">郵便事業株式会社のホームページから
東京の郵便番号のデータ（CSVファイル）を
ダウンロードしdata/12TOKYOCSV として
保存してあります
そのCSVファイルの3列目が郵便番号で、7, 8, 9列目に住所が格納されています
Table関数で3列目をキーとして7, 8, 9列目の住所データを取得します</fb:Property>
						</fb:Description>
						<mp:Property name="Mode">File</mp:Property>
						<mp:Property name="FileType">CSV</mp:Property>
						<mp:Property name="HomeDirectory">Relative</mp:Property>
						<mp:Property name="FilePath">data/13TOKYO.CSV</mp:Property>
						<mp:Property name="Encoding">(AutoDetect)</mp:Property>
						<mp:Property name="InlineTable"/>
						<mp:Property name="KeyColumn">3</mp:Property>
						<mp:Property name="ValueColumn">7,8,9</mp:Property>
						<mp:Property name="IllegalKey">null String</mp:Property>
						<mp:Property name="DefaultValue"/>
					</mp:Function>
					<mp:Function fb:x="356" fb:y="50" name="Concatenate2" type="CONCATENATE">
						<fb:Description height="17" visible="true" width="88" x="356" y="86">
							<fb:Property name="Text">住所を連結します</fb:Property>
						</fb:Description>
						<mp:Property name="Separator"/>
						<mp:Property name="EnableMetaCharacter">false</mp:Property>
						<mp:Property name="NoSeparatorWhenEmpty">false</mp:Property>
						<mp:Input>
							<mp:Item>Link6</mp:Item>
							<mp:Item>Link7</mp:Item>
							<mp:Item>Link8</mp:Item>
						</mp:Input>
					</mp:Function>
					<mp:Link name="Link1">
						<mp:Input fb:x="0" fb:y="0" table="FV/郵便番号"/>
						<mp:Output name="Split1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link2">
						<mp:Input name="Split1"/>
						<mp:Output name="Concatenate1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link3">
						<mp:Input connector="2" name="Split1"/>
						<mp:Output name="Concatenate1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link4">
						<mp:Input name="Concatenate1"/>
						<mp:Output name="Table1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link5">
						<mp:Input name="Concatenate2"/>
						<mp:Output fb:x="0" fb:y="0" table="SD/SD:F/Object"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link6">
						<mp:Input name="Table1"/>
						<mp:Output name="Concatenate2"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link7">
						<mp:Input connector="2" name="Table1"/>
						<mp:Output name="Concatenate2"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link name="Link8">
						<mp:Input connector="3" name="Table1"/>
						<mp:Output name="Concatenate2"/>
						<fb:Line type="Direct"/>
					</mp:Link>
				</mp:Mappings>
			</fe:Property>
			<fe:Output>
				<fe:Stream format="Text">
					<fe:Property name="Encoding">utf-8</fe:Property>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="220" name="EndResponse1" type="EndResponse">
			<fe:Property name="CommitTransaction">true</fe:Property>
			<fe:Property name="ReturnValue"/>
			<fe:Property name="PackRecords">true</fe:Property>
		</fe:Component>
		<fe:Link name="Link1">
			<fe:Input name="Start1"/>
			<fe:Output name="Mapper1"/>
			<fb:Line type="Direct"/>
		</fe:Link>
		<fe:Link name="Link2">
			<fe:Input name="Mapper1"/>
			<fe:Output name="EndResponse1"/>
			<fb:Line type="Direct"/>
		</fe:Link>
		<fe:Variables>
			<fe:Field default="1400014" name="郵便番号" type="String"/>
		</fe:Variables>
	</fe:Flow>
	<fe:Flow id="Flow2" name="レイヤー条件式">
		<fe:Property name="Timeout">180</fe:Property>
		<fe:Property name="Exception"/>
		<fe:Property name="AllowInvoke"/>
		<fe:Property name="LogSettings" unfold="true">
			<fe:Property name="LogName"/>
			<fe:Property name="LogLevel">default</fe:Property>
			<fe:Property name="OutputDefault">true</fe:Property>
		</fe:Property>
		<fe:Property name="CloseSession">true</fe:Property>
		<fe:Property name="HttpExecute">false</fe:Property>
		<fb:Description height="173" width="441" x="118" y="17">
			<fb:Property name="Background">4000ff00</fb:Property>
			<fb:Property name="Text">Mapperの中のレイヤーの条件式のサンプルです

結果という名称の公開フロー変数の値が "normal" であるか "error"　であるかによって
Mapperで実行される処理が変わります

今回の処理であれば、次のような方法も考えられます

・Branchコンポーネントで処理を分岐する
・Mapperの中でIf関数を使用する
・Mapperの中でTable関数を使用してメッセージを変更する

どの方法を使用するかは状況によりますが、レイヤー条件式を使用するとフローやマッピング
がすっきりと分かりやすくなることも多いです</fb:Property>
		</fb:Description>
		<fe:Component fb:x="16" fb:y="16" name="Start1" type="Start">
			<fe:Property name="Exception"/>
			<fe:Property name="BeginTransaction">false</fe:Property>
			<fe:Property name="RequiredRole"/>
			<fe:Property name="ArgumentSyncFlowVariables">true</fe:Property>
			<fe:Output>
				<fe:Stream format="Any"/>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="118" name="Mapper1" type="Mapper2">
			<fe:Property name="Exception"/>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="PassStream">false</fe:Property>
			<fe:Property name="CountZeroException">false</fe:Property>
			<fe:Property name="MvMode">2</fe:Property>
			<fe:Property name="Mappings">
				<mp:Mappings>
					<mp:Layer name="レイヤー1"/>
					<mp:Layer condition="$flow.結果=&quot;normal&quot;" name="結果が &quot;normal&quot; のとき"/>
					<mp:Layer condition="$flow.結果=&quot;error&quot;" name="結果が &quot;error&quot; のとき"/>
					<fb:Description height="70" layer="結果が &quot;normal&quot; のとき" width="394" x="18" y="118">
						<fb:Property name="Background">4000ff00</fb:Property>
						<fb:Property name="Text">レイヤーの条件式として、$flow.結果="normal" が設定されています
※レイヤーのタブをダブルクリックすると条件式を編集することができます

結果という名称のフロー変数の値が "normal" のときのマッピングを書きます
ここでは、Embed関数でメッセージを作成しています</fb:Property>
					</fb:Description>
					<fb:Description height="70" layer="結果が &quot;error&quot; のとき" width="394" x="18" y="120">
						<fb:Property name="Background">4000ff00</fb:Property>
						<fb:Property name="Text">レイヤーの条件式として、$flow.結果="error" が設定されています
※レイヤーのタブをダブルクリックすると条件式を編集することができます

結果という名称のフロー変数の値が "error" のときのマッピングを書きます
ここでは、Embed関数でメッセージを作成しています</fb:Property>
					</fb:Description>
					<fb:Description height="71" layer="レイヤー1" width="361" x="17" y="18">
						<fb:Property name="Background">4000ff00</fb:Property>
						<fb:Property name="Text">このレイヤーは条件式が設定されていないのでどのような場合でも
マッピング処理が実行されます

ここでは、結果という名称のフロー変数の値をログにマッピングしています
ログにマッピングされた場合は、FlowService.log にログとして出力されます</fb:Property>
					</fb:Description>
					<mp:Function fb:x="118" fb:y="50" layer="結果が &quot;normal&quot; のとき" name="Embed1" type="EMBED">
						<mp:Property name="Data">結果は正常です。&#xd;
${input1}</mp:Property>
						<mp:Property name="EnableMetaCharacter">false</mp:Property>
					</mp:Function>
					<mp:Function fb:x="50" fb:y="50" layer="結果が &quot;normal&quot; のとき" name="Now1" type="NOW">
						<mp:Property name="Format">yyyy/MM/dd</mp:Property>
						<mp:Property name="TruncateTime">false</mp:Property>
						<mp:Property name="TimeZone">(default)</mp:Property>
						<mp:Property name="Locale">(default)</mp:Property>
					</mp:Function>
					<mp:Function fb:x="118" fb:y="50" layer="結果が &quot;error&quot; のとき" name="Embed2" type="EMBED">
						<mp:Property name="Data">結果はエラーです。&#xd;
${input1}</mp:Property>
						<mp:Property name="EnableMetaCharacter">false</mp:Property>
					</mp:Function>
					<mp:Function fb:x="50" fb:y="50" layer="結果が &quot;error&quot; のとき" name="Now2" type="NOW">
						<mp:Property name="Format">yyyy/MM/dd</mp:Property>
						<mp:Property name="TruncateTime">false</mp:Property>
						<mp:Property name="TimeZone">(default)</mp:Property>
						<mp:Property name="Locale">(default)</mp:Property>
					</mp:Function>
					<mp:Link layer="結果が &quot;normal&quot; のとき" name="Link1">
						<mp:Input name="Embed1"/>
						<mp:Output fb:x="0" fb:y="0" table="SD/SD:F/Object"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link layer="結果が &quot;normal&quot; のとき" name="Link2">
						<mp:Input name="Now1"/>
						<mp:Output name="Embed1"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link layer="結果が &quot;error&quot; のとき" name="Link3">
						<mp:Input name="Now2"/>
						<mp:Output name="Embed2"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link layer="結果が &quot;error&quot; のとき" name="Link4">
						<mp:Input name="Embed2"/>
						<mp:Output fb:x="0" fb:y="0" table="SD/SD:F/Object"/>
						<fb:Line type="Direct"/>
					</mp:Link>
					<mp:Link layer="レイヤー1" name="Link5">
						<mp:Input fb:x="0" fb:y="0" table="FV/結果"/>
						<mp:Output fb:x="0" fb:y="0" table="Log"/>
						<fb:Line type="Direct"/>
					</mp:Link>
				</mp:Mappings>
			</fe:Property>
			<fe:Output>
				<fe:Stream format="Text">
					<fe:Property name="Encoding">utf-8</fe:Property>
				</fe:Stream>
			</fe:Output>
		</fe:Component>
		<fe:Component fb:x="16" fb:y="220" name="EndResponse1" type="EndResponse">
			<fe:Property name="CommitTransaction">true</fe:Property>
			<fe:Property name="ReturnValue"/>
			<fe:Property name="PackRecords">true</fe:Property>
		</fe:Component>
		<fe:Link name="Link1">
			<fe:Input name="Start1"/>
			<fe:Output name="Mapper1"/>
			<fb:Line type="Direct"/>
		</fe:Link>
		<fe:Link name="Link2">
			<fe:Input name="Mapper1"/>
			<fe:Output name="EndResponse1"/>
			<fb:Line type="Direct"/>
		</fe:Link>
		<fe:Variables>
			<fe:Field default="normal" name="結果" type="String"/>
		</fe:Variables>
	</fe:Flow>
</fe:Project>
